  "narrative": {
    "northStar": "The Nyhavn Facade",
    "overview": "The interface borrows the painted harbour-front houses of Nyhavn. A cool harbour-grey ground holds a navy house card crowned with a stepped gable, and the answers are flat, saturated facade-coloured tiles. Each tile is one painted house: ochre, brick, teal, harbour blue. The palette is cool and mineral with four warm-to-cool accents, and it deliberately avoids the cream, serif and flag-red language-app default.\n\nDensity is phone-first and thumb-sized: one question per screen, full-width tiles, 44px minimum targets, a fixed bottom tab bar on phones. Type is a single geometric grotesk at heavy weights for words and quiet weights for everything else. The answer is communicated by a mark that holds in a fixed white cell, never by colour alone.",
    "keyCharacteristics": [
      "Cool harbour-grey ground, navy anchor, four facade accents.",
      "One typeface (Schibsted Grotesk), weight 800 for words and numbers.",
      "Gabled navy prompt card as the single signature silhouette.",
      "Flat saturated tiles with a soft navy-tinted shadow; no gradients.",
      "State is a tick or cross inside a fixed white cell, plus a ring and strike-through.",
      "Light and dark schemes, both following the system preference."
    ],
    "rules": [
      { "name": "The Four Houses Rule", "body": "Tile colours are assigned by position (ochre, brick, teal, harbour blue) and never carry meaning. Meaning belongs to the state-mark cell.", "section": "colors" },
      { "name": "The Brick Is For Action Rule", "body": "Brick is the single call-to-action colour; it is not used for errors.", "section": "colors" },
      { "name": "The Weight Contrast Rule", "body": "Words and numbers are 800; everything else is 400 to 700. No intermediate display weights.", "section": "typography" },
      { "name": "The Ring Plus Mark Rule", "body": "An answered tile shows a double ring, a glyph in the state-mark cell, and (when wrong) a struck-through label; unanswered tiles dim to 40% opacity. Colour alone never signals correctness.", "section": "elevation" }
    ],
    "dos": [
      "Do keep the ground harbour-grey and the anchor navy; use the four houses only for answer tiles and small facade ornaments.",
      "Do pair every correctness signal with a glyph in the state-mark cell, a ring, and a strike-through on wrong.",
      "Do keep touch targets at 44px or more and the text on ochre dark.",
      "Do use Schibsted Grotesk at 800 for words and numbers, with negative tracking at large sizes.",
      "Do use a 3px ink focus ring (ochre in dark) with 3px offset."
    ],
    "donts": [
      "Don't use cream grounds, serif display faces, or flag-red as a brand colour.",
      "Don't let tile colour imply right or wrong.",
      "Don't put white text on ochre.",
      "Don't add gradients or hard offset shadows; depth is the soft lift and the state ring.",
      "Don't make the state-mark cell resize or move when state changes."
    ]
  }
